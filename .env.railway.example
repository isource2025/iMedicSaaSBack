# Railway — Variables del servicio BACKEND (no commitear secretos)
# Opción A: vincular plugin MySQL al backend (Railway inyecta MYSQLHOST, MYSQLUSER, …)
# Opción B: referencias manuales, ej. AUTH_DB_HOST=${{MySQL.MYSQLHOST}}

AUTH_DB_ENABLED=1
AUTH_DB_HOST=
AUTH_DB_PORT=3306
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_NAME=
AUTH_DB_SSL=0

# Si vinculás MySQL, también valen MYSQLHOST / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE

JWT_SECRET=
# Obligatorio si Empresas usa DbPasswordEnc (mismo valor que al ejecutar setup_empresa_conexion.js en local)
PLATFORM_DB_SECRET=imedic-platform-dev-secret-change-in-prod
CORS_ORIGINS=https://tu-front-2.vercel.app,http://localhost:3000
# Geo-blocking login por país (0=off). Off evita bloqueos Starlink/VPN. 1=solo AuthPaisesPermitidos.
GEO_BLOCK_ENABLED=0
# Cookies cross-origin (front ≠ API): en producción default SameSite=None + Secure.
# Opcional override: COOKIE_SAMESITE=none|lax|strict
# COOKIE_SECURE=1

# SQL plataforma opcional si todo el catálogo está en MySQL Empresas:
# DB_SERVER=
# DB_PORT=1433
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Fallback global de adjuntos (si Empresas.FileServerUrl está vacío):
# FILE_SERVER_URL=https://xxxx.trycloudflare.com
# Preferible: configurar FileServerUrl por empresa en Super Admin → Conexión.

# --- Seguridad file server / PACS / fotos (docs/SEGURIDAD_MISALUD.md) ---
# Clave por clínica para firmar cada pedido al file server y al bridge PACS.
# Opción A: una maestra y las claves de cada clínica se derivan con
#   node scripts/tunnel/clave-firma.js --servicio fs|pacs --empresa <id>
# IMEDIC_SIGNING_MASTER=
# Opción B (o para pisar alguna): mapa explícito IDEMPRESA -> clave (mín. 32 caracteres)
# FILE_SERVER_SIGNING_KEYS={"101":"..."}
# PACS_SIGNING_KEYS={"101":"..."}
# Vida de cada token firmado (segundos, máx. 900):
# FILE_SERVER_SIGNING_TTL_S=120
# PACS_SIGNING_TTL_S=120
# LEGADO: token fijo compartido. Quitar cuando todas las clínicas tengan clave de firma.
# FILE_SERVER_TOKEN=
# PACS_BRIDGE_KEY=
# Fotos de pacientes (/media/patients, /uploads): URLs firmadas. Si falta, se deriva de JWT_SECRET.
# MEDIA_URL_SECRET=
# MEDIA_URL_TTL_S=7200

# --- Chatbot WhatsApp (API /api/integrations/bot) ---
# Una empresa: BOT_API_KEY + BOT_EMPRESA_ID
# Multi-tenant: BOT_API_KEYS={"1":"clave-empresa-1","2":"clave-empresa-2"}
BOT_API_KEY=
BOT_EMPRESA_ID=1
# BOT_API_KEYS={"1":"genera-clave-segura-aqui"}

# --- Meta WhatsApp Cloud API (webhook público) ---
# Callback URL en Meta:
#   https://imedicwsback-production.up.railway.app/api/webhook/whatsapp
WHATSAPP_VERIFY_TOKEN=imedic_verify_2026
META_APP_ID=
META_APP_SECRET=
# Si Graph API OK pero HMAC falla con facebookexternalua (proxy Railway), habilitar:
WHATSAPP_WEBHOOK_TRUST_META_UA=1
# BOT_WHATSAPP_RESET_PIN=reset-imedic-dev
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

BOT_COD_OPERADOR=999
BOT_NOMBRE_INSTITUCION=Hospital iMedic
BOT_ANTICIPACION_MIN_HORAS=2
BOT_DIAS_MAX_ANTELACION=60
BOT_MAX_TURNOS_POR_PACIENTE_DIA=1
BOT_REQUIERE_DNI=1
BOT_REQUIERE_RENAPER=1
BOT_CREAR_PACIENTE_AUTO=1
# Si Railway no alcanza MSAL directo, proxy vía servidor con acceso (ej. ngrok a tu PC local):
# RENAPER_PROXY_BASE_URL=https://xxxx.ngrok-free.app/api/integrations/bot
# RENAPER_PROXY_API_KEY=misma-clave-que-BOT_API_KEY
BOT_SUGERIR_PRIMER_TURNO=1

# === Asistente embebido (chat del dashboard) ===
# ASISTENTE_OPENAI_API_KEY=   # recomendado; si falta usa OPENAI_API_KEY
# ASISTENTE_OPENAI_MODEL=gpt-4o-mini
ASISTENTE_CUOTA_MENSAJES=15
# ASISTENTE_CUOTA_DESDE=2026-10-28
# Roles sin tope (default ADMIN,SUPER_ADMIN). Actores: ASISTENTE_CUOTA_EXENTOS=1:10
# Solo Soporte en produ hasta validar Internación en copia:
ASISTENTE_INTERNACION_LISTO=0
# ASISTENTE_INTERNACION_ESCRITURA=
